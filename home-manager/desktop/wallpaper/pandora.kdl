// should go in ~/.config/pandora/pandora.kdl (or $XDG_CONFIG_HOME/pandora/pandora.kdl)
output "eDP-1" {
    image "~/.config/wallpapers/0001.png"
    mode "scroll-vertical"
}

animation {
    // Slow down animation by this factor. Values below 1 speeds up instead.
    // slowdown 0.5
}

// logging "default"
