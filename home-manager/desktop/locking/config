# See Swaylock (1) manpage
# or https://github.com/swaywm/swaylock/blob/master/swaylock.1.scd

image=~/.config/wallpapers/0001.png

ignore-empty-password

font=fira-code
font-size=46

indicator-idle-visible
indicator-radius=150
indicator-thickness=40

inside-color=24273a
inside-clear-color=24273a
inside-caps-lock-color=24273a
inside-ver-color=24273a
inside-wrong-color=24273a

# show-keyboard-layout
layout-bg-color=00000000
layout-border-color=00000000
layout-text-color=cad3f5

line-color=363a4f
line-clear-color=363a4f
line-caps-lock-color=363a4f
line-ver-color=363a4f
line-wrong-color=363a4f

key-hl-color=8aadf4
separator-color=00000000
ring-color=24273a
ring-clear-color=a6da95
ring-caps-lock-color=eed49f
ring-ver-color=8aadf4
ring-wrong-color=ed8796

text-color=cad3f5
text-clear-color=cad3f5
text-caps-lock-color=cad3f5
text-ver-color=cad3f5
text-wrong-color=cad3f5

clock
timestr=%H:%M:%S
datestr=%a %d-%b-%y

screenshots

effect-blur=10x3
effect-scale=0.5

