[
  {
    "layer": "top",
    "position": "top",
    "height": 23,
    "modules-left": [ "custom/logo", "cpu", "memory", "temperature", "disk", "custom/powerDraw"],
    "modules-center": [ "clock" , "custom/weather"],
    "modules-right": [ "idle_inhibitor", "backlight", "pulseaudio", "custom/colorpicker", "bluetooth", "network", "battery" ],
    "reload_style_on_change":true,

    "custom/logo": {
      "format": " alex<span color=\"#cad3f5\">@</span>serafina ",
      "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M:%S %a %d-%b-%y} ",
        "interval":1,
        "tooltip-format": "\n<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar-weeks-pos": "right",
        "today-format": "<span color='#7645AD'><b><u>{}</u></b></span>",
        "format-calendar": "<span color='#aeaeae'><b>{}</b></span>",
        "format-calendar-weeks": "<span color='#aeaeae'><b>W{:%V}</b></span>",
        "format-calendar-weekdays": "<span color='#aeaeae'><b>{}</b></span>"
    },


    "custom/weather": {
      "format": "{} ",
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/weather.sh",
      "interval": 10,
      "tooltip": true
    },

    "disk": {
      "interval": 30,
      "format": "\uf0a0 {percentage_used}% ",
      "tooltip-format": "{used} / {total}\n{free} ({percentage_free}%) free",
      "path": "/",
    },

    "memory": {
      "format": "\uf538 {percentage}% ",
      "on-click": "foot btop",
    },

    "cpu": {
      "interval": 1,
      "format": "<span background=\"#363a4f\">{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}<span color=\"#b7bdf8\">{icon8}{icon9}</span></span> ",
      "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
      "markup": true,
      "on-click": "foot btop",
    },

    "temperature": {
      "format": " {temperatureC}°C ",            
      "format-critical": " {temperatureC}°C",
      "interval": 1,
      "critical-threshold": 80,
      "on-click": "foot btop",
    },

    "custom/powerDraw": {
      "format": "\uf0e7 {}w ",
      "interval": 1,
      "exec": "~/.config/waybar/scripts/powerdraw.sh",
      "return-type": "json",
      "on-click": "foot btop",
    },

    "backlight": {
      "device": "intel_backlight",
      "format": "{icon} {percent}% ",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "\ue39b"
      ],
    },

    "custom/colorpicker": {
      "format": "{} ",
      "return-type": "json",
      "interval": "once",
      "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
      "on-click": "sleep 1 && ~/.config/waybar/scripts/colorpicker.sh",
      "signal": 1
    },

    "bluetooth": {
      "format-on": " ",
      "format-off": "󰂲 ",
      "format-disabled": "󰂲 ",
      "format-connected": "󰂴 ",
      "format-connected-battery": "󰂴 {device_battery_percentage}% ",
      "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    }, 

    "pulseaudio": {
      "format": "{icon} {volume}% ",
      "format-bluetooth":"󰂰 {volume}% ",
      "format-muted": " {volume}% ",
      "format-icons": {
        "headphones": "",
        "bluetooth": "󰥰",
        "handsfree": "",
        "headset": "󱡬",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["\udb81\udcc3"]
      },
      "tooltip-format": "{icon} {volume}%\n{desc}"
    },

    "network": {
          "format-wifi": "  {essid} ",
          "format-ethernet":" ",
          "format-disconnected": " ",
          "tooltip-format": "{ipaddr}",
          "tooltip-format-wifi": "{essid} ({signalStrength}%)  | {ipaddr}",
          "tooltip-format-ethernet": "{ifname} 🖧 | {ipaddr}",
          "on-click": "networkmanager_dmenu"
        },

    "battery": {
        "interval":1,
        "states": {
            "good": 80,
            "warning": 20,
            "critical": 5
        },
        "format": "{time:.11} {icon} {capacity}% ",
        "format-charging": "{time:.11} 󰂄 {capacity}% ",
        "format-plugged": " capacity}% ",
            "format-icons": [
        "\udb80\u008e",
        "\udb80\u007a",
        "\udb80\u007b",
        "\udb80\udc7c",
        "\udb80\udc7d",
        "\udb80\udc7e",
        "\udb80\udc7f",
        "\udb80\udc80",
        "\udb80\udc81",
        "\udb80\udc82",
        "\udb80\udc79",
        ],
    },

    "idle_inhibitor": {
      "format": "{icon} ",
      "format-icons": {
          "activated": "󱜤 ",
          "deactivated": "󰌢 "
      }
    }
  },

  {
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "modules-left": [ "cffi/niri-taskbar" ],
    "modules-center": [ "custom/workspaces" ],
    "modules-right": [ "image#album-art",  "mpris" ],
    "reload_style_on_change":true,

    // "wlr/taskbar": {
    //   "format": " {icon} <b>{name}  {short_state}</b> \n {title:.20} ",
    //   "icon-size": 25,
    //   "tooltip-format": "{title}",
    //   "active-first": true,
    //   "ignore-list": [
    //     "kitty"
    //   ],
    //   "on-click": "activate",
    //   "on-click-middle": "close",
    //   "markup": true,
    // },
    
    "cffi/niri-taskbar": {
      "module_path": "/nix/store/fi8chv0psxy0ddb7wg58hakdhvfs93pp-niri-taskbar-0.3.0+niri.25.08/lib/libniri_taskbar.so", 
      "notifications": {
        "enable": true,
      },
      "show_all_outputs": true,
    },

    "image#album-art": {
     "exec":"~/.config/waybar/scripts/album-art.sh",
     "size": 30,
     "interval": 5,  
    },

    "mpris": {
      "format": "  {status_icon} {title} - {album}  \n  {artist}  ",
      "status-icons": {
        "playing": "\uf04b",
        "paused": "\uf04c",
        "stopped": "\uf04d"
      }
    },

    "custom/workspaces": {
      "exec": "~/.config/waybar/scripts/workspaces.sh",
      "restart-interval": 60,
      "return-type": "json",
      "format": "{}"
    }
  }
]
