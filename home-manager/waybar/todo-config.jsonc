[
  {
    "layer": "top",
    "exclusive": false,
    "position": "left",
    "modules-left": ["custom/todo"],
    "reload_style_on_change":true,

    "custom/todo": {
      "exec": "~/.config/waybar/scripts/todo.sh",
      "interval": 1,
      "return-type": "json",
      "format": "{}"
    }
  }
]
